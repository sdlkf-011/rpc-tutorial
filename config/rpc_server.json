{
  "servers_name_prefix": "cookrpc",
  "servers_ip": "0.0.0.0",
  "servers_port": 8989,
  "max_connections": 10000,
  "listen_backlog": 1024,
  "timeout": 5000,
  "scheduler": {
    "zk_namespace": "/cookrpc",
    "retry_interval": 1000,
    "zk_host": "localhost",
    "zk_port": 2181,
    "load_balance_strategy": "round"
  },
  "thread_pool": {
    "max_threads": 10,
    "core_threads": 8,
    "queue_size": 10000,
    "keep_alive_time": 60
  },
  "load_balance_strategy": "round",
  "register_config": "../config/servers.json",
  "transport": {
    "compression": true,
    "compression_threshold": 1024,
    "encryption": false
  },
  "rate_limit": {
    "requests_per_second": 0,
    "burst": 0
  }
}
